{
  "name": "runheat",
  "private": true,
  "version": "1.2.0",
  "license": "MIT",
  "description": "Every run you have ever done, on one map: routes, heatmaps and stats from your GPS files, in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint .",
    "preversion": "npm run check && npm run build",
    "postversion": "git push --follow-tags",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "d3-transition": "^3.0.2",
    "fflate": "^0.8.3",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.18.0"
  }
}
